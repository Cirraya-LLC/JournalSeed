JOURNALSEED_HOST=127.0.0.1
JOURNALSEED_PORT=8080
JOURNALSEED_DATABASE_URL=postgresql://journalseed:journalseed@127.0.0.1:5432/journalseed
JOURNALSEED_LUA_DIR=./scripts/functions
JOURNALSEED_STATIC_DIR=./frontend/build

# ---------------------------------------------------------------------------
# 以下变量只从进程环境读取，config.json 与命令行参数都不支持，管理 API 也无法改写。
# The variables below are read from the process environment only. They are not
# accepted in config.json or on the command line, and the admin API cannot set them.
# ---------------------------------------------------------------------------

# 加密链配置里 TronGrid/Etherscan API Key 与自定义 RPC URL 的主密钥。
# 接受 32 字节密钥的十六进制（64 个字符）或 Base64 形式；否则按口令处理，
# 用 Argon2id 派生，口令至少 16 个字符。推荐直接生成随机密钥：
#     openssl rand -hex 32
#
# 破坏性变更：密钥派生方式已从裸 BLAKE2b 改为上述方案，用旧方案加密的链配置
# 无法再解密。升级后请在链设置页面重新填写并保存一次凭据。现在这种情况会明确
# 报 chain_settings_secret_undecryptable（500），而不是静默退化成匿名 RPC 调用。
#
# Master key for the TronGrid/Etherscan API keys and custom RPC URLs stored in
# chain settings. Accepts a 32-byte key as hex (64 characters) or base64;
# anything else is treated as a passphrase and stretched with Argon2id, and must
# be at least 16 characters. Generating a random key is preferred:
#     openssl rand -hex 32
#
# BREAKING CHANGE: key derivation moved from bare BLAKE2b to the above, so chain
# settings encrypted under the old scheme no longer decrypt. Re-enter and save
# them once after upgrading. This now surfaces as an explicit
# chain_settings_secret_undecryptable (500) instead of silently degrading to
# unauthenticated RPC calls.
# JOURNALSEED_CHAIN_SETTINGS_KEY=

# 出网（SSRF）白名单逃生舱：逗号分隔的主机名列表，列出的主机跳过“解析结果不得落在
# 回环/内网/链路本地/组播地址”的检查。仅用于节点确实部署在内网或本机的场景。
# 之所以只认进程环境而不做成管理 API 配置项：这条开关的作用就是允许服务端向内网发起
# 请求，如果能通过网页写入，拿到管理员会话的攻击者就能自己把目标主机加进白名单，整套
# SSRF 防护也就形同虚设。放在进程环境里，改动它需要宿主机 shell 权限。
#
# Egress (SSRF) allowlist escape hatch: comma-separated hostnames that skip the
# "must not resolve to a loopback/private/link-local/multicast address" check.
# Only for nodes genuinely running on a private address or on the host itself.
# It is deliberately environment-only rather than an admin API setting: this
# switch exists to let the server reach private networks, so if it were writable
# over the web an attacker holding an admin session could allowlist their own
# target and the SSRF protection would be worth nothing. Kept here, changing it
# requires shell access to the host.
# JOURNALSEED_RPC_ALLOW_HOSTS=127.0.0.1,geth.internal

# Etherscan V2 接口的基地址，用于 Ethereum/Polygon 转账历史。默认 https://api.etherscan.io。
# Base URL for the Etherscan V2 API used for Ethereum/Polygon transfer history.
# Defaults to https://api.etherscan.io.
# JOURNALSEED_ETHERSCAN_BASE_URL=https://api.etherscan.io

# 未在链设置里保存自定义 Solana RPC URL 时使用的默认 endpoint。
# 默认 https://api.mainnet-beta.solana.com（公共节点，容易限流）。
# Fallback Solana RPC endpoint used when no custom URL is saved in chain settings.
# Defaults to https://api.mainnet-beta.solana.com, a rate-limited public node.
# JOURNALSEED_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# 手动验收用的确定性 mock 同步数据；设为 1 启用。JOURNALSEED_MOCK_MULTICHAIN_SYNC 为
# 等价别名，JOURNALSEED_MOCK_TRON_SYNC 只 mock TRON 钱包。
# Deterministic mock sync data for manual acceptance; set to 1 to enable.
# JOURNALSEED_MOCK_MULTICHAIN_SYNC is an equivalent alias, and
# JOURNALSEED_MOCK_TRON_SYNC mocks TRON wallets only.
# JOURNALSEED_MOCK_CHAIN_SYNC=1
